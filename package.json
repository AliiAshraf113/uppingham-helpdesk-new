{
  "name": "uppingham-it-helpdesk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node server.js",
    "package:cpanel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-cpanel.ps1",
    "db:migrate": "node scripts/migrate.mjs",
    "db:diagnose": "node scripts/diagnose-db-connection.mjs",
    "db:reset": "node scripts/reset-database.mjs",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "mariadb": "3.5.4",
    "next": "^16.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
