# MariaDB connection (server-only; use a least-privileged runtime account)
DATABASE_URL=mysql://helpdesk_runtime:replace-me@127.0.0.1:3306/ucegcom_uppingham_helpdesk
DB_POOL_LIMIT=5
MARIADB_TLS=false

# Separate, more privileged identity; used only by the explicit migration command.
MIGRATOR_DATABASE_URL=mysql://helpdesk_migrator:replace-me@127.0.0.1:3306/ucegcom_uppingham_helpdesk

# Private attachment directory. Must be outside public_html and writable by the app.
ATTACHMENT_STORAGE_DIR=/home/ACCOUNT/private/helpdesk-attachments

# Set only after confirming these values with the cPanel host and Entra administrator.
ENTRA_TENANT_ID=
AUTH_SECRET=
# Auth.js base endpoint (AUTH_URL includes the Auth.js base path, not just the site path).
AUTH_URL=http://localhost:3000/helpdesk/api/auth
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Comma-separated Entra group object IDs; access is denied when required allowlists are unset.
ENTRA_ADMIN_GROUP_IDS=
ENTRA_STAFF_GROUP_IDS=
